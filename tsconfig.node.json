{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["es2022", "dom"],
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "dist/node",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": [
    "worker/**/*.ts",
    "scripts/**/*.ts",
    "lib/config.ts",
    "lib/db.ts",
    "lib/mailer.ts",
    "lib/corridas.ts",
    "lib/engine/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", "dist"]
}
