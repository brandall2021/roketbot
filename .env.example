# ============================================================================
# Expedientes (juridico + roketbot unificados) — todas las variables de entorno
#
# Copiar a `.env` y completar. `.env` está en .gitignore: nunca se commitea.
# En Dokploy van en el bloque de Environment del servicio, no en este archivo.
# ============================================================================

# --- Base de datos (PostgreSQL) ---------------------------------------------
# Fuente de verdad única. El panel y el worker usan la MISMA cadena.
# Se acepta el formato viejo del bot (`postgresql+psycopg://...`): lo normaliza
# lib/config.ts antes de conectar. Con Postgres afuera del host, sslmode=require.
DATABASE_URL=postgresql://expedientes:CAMBIAR@127.0.0.1:5432/expedientes?sslmode=require

# Pool del panel: conexiones máximas por proceso.
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=60000
DB_TIMEOUT_CONEXION_MS=10000

# --- Login del panel --------------------------------------------------------
# REQUIRED. Rotarla invalida todas las sesiones abiertas.
JWT_SECRET=
JWT_EXPIRES=7d
APP_URL=http://localhost:3000

# --- Administrador inicial (npm run seed / SEED_AL_INICIAR=1) ---------------
# En producción ADMIN_PASSWORD es obligatoria y se rechazan las conocidas
# (admin, admin123, password, ...): mínimo 10 caracteres.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NOMBRE=Administrador
ADMIN_ROL=ADMIN

# --- Arranque del contenedor ------------------------------------------------
# 1 = aplicar migrations/*.sql antes de subir el panel (sólo en el servicio `app`).
MIGRAR_AL_INICIAR=1
# 1 = correr el seed al subir. Dejar en 0 después del primer arranque.
SEED_AL_INICIAR=0

# --- Consulta al Poder Judicial ---------------------------------------------
# No son secretos: son los endpoints públicos del PJud de Tucumán.
PJUD_API_BASE=https://conexpbe.justucuman.gov.ar/api/proceedings
PJUD_FRONTEND=https://consultaexpedientes.justucuman.gov.ar/documentos/buscador
PJUD_SITEKEY=6LeIn2IsAAAAAKF_7oDVKBPy-sAV2JwIRySx57H6

# Ritmo de consulta. REQUEST_DELAY_S es un acuerdo implícito con el servidor del
# PJud: bajarlo es arriesgarse a que corten el acceso, no a consultar más rápido.
REQUEST_DELAY_S=3
REQUEST_TIMEOUT_S=30
MAX_EXPEDIENTES_PER_RUN=500

# --- Captcha ----------------------------------------------------------------
# none | twocaptcha. `playwright` no está portado a Node: avisa y no consulta.
CAPTCHA_PROVIDER=none
# SECRETO. Créditos reales: no lo pegues en un issue ni en un log.
TWOCAPTCHA_KEY=
TWOCAPTCHA_POLL_TIMEOUT_S=120
# El token de reCAPTCHA dura ~2 minutos; se reutiliza hasta vencer (90 s por
# seguridad) y se renueva si el PJud lo rechaza.
CAPTCHA_TOKEN_TTL_S=90
# Token manual para probar una corrida sin gastar captcha (uso puntual, no lo dejes
# puesto en el servicio).
CAPTCHA_TOKEN=

# --- Worker residente -------------------------------------------------------
WORKER_INTERVALO_S=3600

# --- Mail del resumen (opcional) --------------------------------------------
# Si falta SMTP_HOST o MAIL_DESTINATARIOS, el resumen queda en la tabla
# `notificaciones` como ERROR y la corrida termina igual: el mail es accesorio.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=true
MAIL_DESTINATARIOS=
