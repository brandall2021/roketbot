# Copiar a .env y completar. El .env real NO se commitea.
DATABASE_URL=postgresql+psycopg://usuario:password@host:5432/rocketbot

# --- API del Poder Judicial ---
PJUD_API_BASE=https://conexpbe.justucuman.gov.ar/api/proceedings
PJUD_FRONTEND=https://consultaexpedientes.justucuman.gov.ar/documentos/buscador
PJUD_SITEKEY=6LeIn2IsAAAAAKF_7oDVKBPy-sAV2JwIRySx57H6

# --- Captcha ---
# none | twocaptcha | playwright
CAPTCHA_PROVIDER=none
TWOCAPTCHA_KEY=
TWOCAPTCHA_POLL_TIMEOUT_S=120
# El token de reCAPTCHA dura ~2 min; se renueva solo durante la corrida.
CAPTCHA_TOKEN_TTL_S=90

# --- Ritmo de consulta (respetar el servidor del PJud) ---
REQUEST_DELAY_S=3.0
REQUEST_TIMEOUT_S=30.0
MAX_EXPEDIENTES_PER_RUN=500

# --- Mail (opcional) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=true
MAIL_DESTINATARIOS=

LOG_LEVEL=INFO
