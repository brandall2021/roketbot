{
  "name": "expedientes",
  "version": "0.2.0",
  "private": true,
  "description": "Expedientes del Poder Judicial de Tucumán: panel web + consulta automática (unificación de juridico y roketbot)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "tsx scripts/migrate.ts",
